#!/usr/bin/env bash
set -euo pipefail

step() {
    local label="$1"
    local started="$SECONDS"
    shift
    printf '[orb-setup] %s\n' "$label"
    "$@"
    printf '[orb-setup] %s completed in %ss\n' "$label" "$((SECONDS - started))"
}

install_dependencies() {
    local -a sudo=() packages=()
    local need_docker=false

    if [[ "$(id -u)" -ne 0 ]]; then
        sudo=(sudo -n)
    fi

    if ! command -v docker >/dev/null 2>&1 \
        || ! command -v dockerd >/dev/null 2>&1 \
        || ! docker buildx version >/dev/null 2>&1; then
        need_docker=true
    fi

    if [[ "${need_docker}" == true ]]; then
        if ! command -v curl >/dev/null 2>&1; then
            "${sudo[@]}" apt-get update
            "${sudo[@]}" apt-get install -y ca-certificates curl
        fi

        local source=/etc/apt/sources.list.d/docker.list
        local architecture codename

        if [[ ! -f "${source}" ]] \
            || ! grep -Fq 'download.docker.com/linux/debian' "${source}"; then
            local keyring=/etc/apt/keyrings/docker.asc

            "${sudo[@]}" install -m 0755 -d /etc/apt/keyrings
            if [[ ! -s "${keyring}" ]]; then
                curl -fsSL https://download.docker.com/linux/debian/gpg \
                    | "${sudo[@]}" tee "${keyring}" >/dev/null
            fi
            "${sudo[@]}" chmod a+r "${keyring}"

            architecture="$(dpkg --print-architecture)"
            # shellcheck disable=SC1091
            codename="$(. /etc/os-release && printf '%s' "${VERSION_CODENAME}")"
            printf 'deb [arch=%s signed-by=%s] https://download.docker.com/linux/debian %s stable\n' \
                "${architecture}" "${keyring}" "${codename}" \
                | "${sudo[@]}" tee "${source}" >/dev/null
        fi

        packages+=(docker-ce docker-ce-cli containerd.io docker-buildx-plugin)
    fi

    command -v jq >/dev/null 2>&1 || packages+=(jq)
    command -v shellcheck >/dev/null 2>&1 || packages+=(shellcheck)

    if ((${#packages[@]})); then
        "${sudo[@]}" apt-get update
        "${sudo[@]}" apt-get install -y "${packages[@]}"
    fi

    command -v docker >/dev/null
    command -v dockerd >/dev/null
    docker buildx version
    command -v jq >/dev/null
    command -v shellcheck >/dev/null
}

step 'Install Docker Engine, Buildx, and repository test tools' install_dependencies
